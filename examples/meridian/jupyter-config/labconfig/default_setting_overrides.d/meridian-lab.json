{
  "@jupyterlab/apputils-extension:themes": {
    "theme": "Meridian Dark",
    "adaptive-theme": false,
    "preferred-light-theme": "Meridian Light",
    "preferred-dark-theme": "Meridian Dark",
    "theme-scrollbars": true
  },
  "@jupyterlab/apputils-extension:notification": {
    "fetchNews": "false",
    "checkForUpdates": false
  },
  "@jupyterlab/application-extension:shell": {
    "startMode": "multiple",
    "dockPanelPadding": false,
    "layout": {
      "multiple": {
        "File Browser": {
          "area": "left",
          "options": {
            "rank": 100
          }
        },
        "jp-search-replace": {
          "area": "left",
          "options": {
            "rank": 200
          }
        },
        "jp-git-sessions": {
          "area": "left",
          "options": {
            "rank": 300
          }
        },
        "Debugger": {
          "area": "left",
          "options": {
            "rank": 400
          }
        },
        "extensionmanager.main-view": {
          "area": "left",
          "options": {
            "rank": 500
          }
        },
        "Sessions and Tabs": {
          "area": "left",
          "options": {
            "rank": 600
          }
        },
        "Table of Contents": {
          "area": "left",
          "options": {
            "rank": 700
          }
        },
        "Property Inspector": {
          "area": "left",
          "options": {
            "rank": 800
          }
        },
        "Terminal": {
          "area": "down"
        },
        "lsp-diagnostics-panel": {
          "area": "down"
        },
        "jp-variableinspector": {
          "area": "down"
        }
      }
    }
  },
  "@jupyterlab/filebrowser-extension:browser": {
    "showLastModifiedColumn": false,
    "singleClickNavigation": true
  },
  "@jupyterlab/codemirror-extension:plugin": {
    "defaultConfig": {
      "theme": "meridian",
      "autoClosingBrackets": true,
      "codeFolding": true,
      "highlightActiveLine": true,
      "lineHeight": 1.357
    }
  },
  "@jupyterlab/terminal-extension:plugin": {
    "fontFamily": "'Noto Sans Mono', 'Droid Sans Mono', monospace",
    "fontSize": 14,
    "lineHeight": 1.2
  },
  "@jupyter-lsp/jupyterlab-lsp:hover": {
    "autoActivate": true
  },
  "jupyterlab_code_formatter:settings": {
    "preferences": {
      "default_formatter": {
        "python": [
          "ruffformat"
        ]
      }
    },
    "suppressFormatterErrorsIFFAutoFormatOnSave": true
  },
  "jupyterlab-highlight-selected-word:plugin": {
    "highlightColor": "rgba(173, 214, 255, 0.15)",
    "highlightColorBlurred": "rgba(173, 214, 255, 0.1)",
    "outlineColor": "transparent",
    "outlineWidth": 0
  },
  "jupyterlab-execute-time:settings": {
    "showDate": false,
    "historyCount": 0,
    "textContrast": "low"
  },

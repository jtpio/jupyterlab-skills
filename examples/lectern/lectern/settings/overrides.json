{
  "@jupyterlab/notebook-extension:panel": {
    "toolbar": [
      {
        "name": "save",
        "disabled": true
      },
      {
        "name": "insert",
        "disabled": true
      },
      {
        "name": "cut",
        "disabled": true
      },
      {
        "name": "copy",
        "disabled": true
      },
      {
        "name": "paste",
        "disabled": true
      },
      {
        "name": "restart-and-run",
        "disabled": true
      },
      {
        "name": "spacer",
        "disabled": true
      },
      {
        "name": "kernelName",
        "disabled": true
      },
      {
        "name": "executionProgress",
        "disabled": true
      },
      {
        "name": "run",
        "label": "Run"
      },
      {
        "name": "interrupt",
        "label": "Stop"
      },
      {
        "name": "restart",
        "label": "Restart"
      }
    ]
  },
  "@jupyterlab/notebook-extension:tracker": {
    "kernelShutdown": true
  },
  "@jupyterlab/shortcuts-extension:shortcuts": {
    "shortcuts": [
      {
        "command": "lectern:next",
        "keys": [
          "Alt ArrowRight"
        ],
        "selector": "body"
      },
      {
        "command": "lectern:previous",
        "keys": [
          "Alt ArrowLeft"
        ],
        "selector": "body"
      }
    ]
  }
}

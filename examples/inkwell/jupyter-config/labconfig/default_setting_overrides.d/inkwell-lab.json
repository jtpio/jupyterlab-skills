{
  "@jupyterlab/apputils-extension:notification": {
    "fetchNews": "false",
    "checkForUpdates": false
  },
  "@jupyterlab/statusbar-extension:plugin": {
    "visible": false
  },
  "@jupyterlab/application-extension:shell": {
    "layout": {
      "multiple": {
        "table-of-contents": {
          "area": "left",
          "options": {
            "rank": 1
          }
        },
        "filebrowser": {
          "area": "right",
          "options": {
            "rank": 1
          }
        }
      },
      "single": {
        "table-of-contents": {
          "area": "left",
          "options": {
            "rank": 1
          }
        },
        "filebrowser": {
          "area": "right",
          "options": {
            "rank": 1
          }
        }
      }
    }
  },

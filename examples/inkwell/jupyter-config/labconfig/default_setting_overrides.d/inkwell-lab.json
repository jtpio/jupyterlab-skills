  "@jupyterlab/notebook-extension:panel": {
    "toolbar": [
      {
        "name": "cut",
        "disabled": true
      },
      {
        "name": "copy",
        "disabled": true
      },
      {
        "name": "paste",
        "disabled": true
      },
      {
        "name": "restart",
        "disabled": true
      },
      {
        "name": "restart-and-run",
        "disabled": true
      },
      {
        "name": "insert-section",
        "command": "inkwell-lab:insert-section",
        "rank": 21,
        "label": "Section"
      },
      {
        "name": "run-all",
        "command": "notebook:run-all-cells",
        "rank": 32,
        "label": "Run all",
        "icon": "ui-components:fast-forward"
      },
      {
        "name": "clear-all",
        "command": "notebook:clear-all-cell-outputs",
        "rank": 33,
        "label": "Clear outputs",
        "icon": "ui-components:clear"
      }
    ]
  },
  "@jupyterlab/shortcuts-extension:shortcuts": {
    "shortcuts": [
      {
        "command": "apputils:activate-command-palette",
        "keys": [
          "Accel Shift C"
        ],
        "selector": "body",
        "disabled": true
      },
      {
        "command": "apputils:activate-command-palette",
        "keys": [
          "Accel K"
        ],
        "selector": "body"
      },
      {
        "command": "notebook:run-all-cells",
        "keys": [
          "Accel Shift Enter"
        ],
        "selector": ".jp-Notebook"
      },
      {
        "command": "inkwell-lab:insert-section",
        "keys": [
          "Accel Alt S"
        ],
        "selector": ".jp-Notebook"
      },
      {
        "command": "inkwell-lab:toggle-focus",
        "keys": [
          "Accel Alt F"
        ],
        "selector": "body"
      }
    ]
  },
  "@jupyterlab/docmanager-extension:plugin": {
    "autosave": true,
    "autosaveInterval": 30
  },
  "@jupyterlab/notebook-extension:tracker": {
    "codeCellConfig": {
      "lineWrap": true
    },
    "markdownCellConfig": {
      "lineWrap": true
    },
    "rawCellConfig": {
      "lineWrap": true
    },
    "defaultCell": "markdown",
    "autoRenderMarkdownCells": true,
    "autoStartDefaultKernel": true,
    "scrollPastEnd": false
  },
  "@jupyterlab/fileeditor-extension:plugin": {
    "editorConfig": {
      "lineWrap": true,
      "lineNumbers": false
    }
  },
  "@jupyterlab/cell-toolbar-extension:plugin": {
    "askCellDeleteConfirmation": false
  },
  "@jupyterlab/apputils-extension:themes": {
    "theme-scrollbars": true,
    "theme": "Inkwell Paper",
    "preferred-light-theme": "Inkwell Paper",
    "preferred-dark-theme": "Inkwell Night",
    "adaptive-theme": false
  },
  "@jupyterlab/application-extension:top-bar": {
    "toolbar": [
      {
        "name": "inkwell-focus",
        "command": "inkwell-lab:toggle-focus",
        "args": {
          "short": true
        },
        "rank": 60
      },
      {
        "name": "inkwell-theme",
        "command": "inkwell-lab:toggle-theme",
        "args": {
          "short": true
        },
        "rank": 61
      }
    ]
  }
}

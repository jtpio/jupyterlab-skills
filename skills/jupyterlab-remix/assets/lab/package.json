{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rspack build",
    "build:prod": "npm run clean && rspack build --mode production",
    "clean": "rimraf build my_app/static my_app/schemas my_app/themes",
    "watch": "rspack build --watch"
  },
  "dependencies": {
    "@jupyterlab/application": "~4.6.6",
    "@jupyterlab/application-extension": "~4.6.6",
    "@jupyterlab/apputils": "~4.7.6",
    "@jupyterlab/apputils-extension": "~4.6.6",
    "@jupyterlab/codemirror-extension": "~4.6.6",
    "@jupyterlab/completer-extension": "~4.6.6",
    "@jupyterlab/coreutils": "~6.6.6",
    "@jupyterlab/docmanager-extension": "~4.6.6",
    "@jupyterlab/filebrowser-extension": "~4.6.6",
    "@jupyterlab/fileeditor-extension": "~4.6.6",
    "@jupyterlab/mainmenu": "~4.6.6",
    "@jupyterlab/mainmenu-extension": "~4.6.6",
    "@jupyterlab/markedparser-extension": "~4.6.6",
    "@jupyterlab/notebook-extension": "~4.6.6",
    "@jupyterlab/rendermime-extension": "~4.6.6",
    "@jupyterlab/shortcuts-extension": "~5.4.6",
    "@jupyterlab/theme-dark-extension": "~4.6.6",
    "@jupyterlab/theme-light-extension": "~4.6.6",
    "@jupyterlab/translation-extension": "~4.6.6",
    "@jupyterlab/ui-components-extension": "~4.6.6",
    "@lumino/widgets": "^2.7.0"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.3.0",
    "@rspack/cli": "^2.3.2",
    "@rspack/core": "^2.3.2",
    "css-loader": "^7.1.4",
    "rimraf": "^5.0.5",
    "style-loader": "^4.0.0"
  },
  "jupyterlab": {
    "extensions": [
      "@jupyterlab/application-extension",
      "@jupyterlab/apputils-extension",
      "@jupyterlab/codemirror-extension",
      "@jupyterlab/completer-extension",
      "@jupyterlab/docmanager-extension",
      "@jupyterlab/filebrowser-extension",
      "@jupyterlab/fileeditor-extension",
      "@jupyterlab/mainmenu-extension",
      "@jupyterlab/markedparser-extension",
      "@jupyterlab/notebook-extension",
      "@jupyterlab/rendermime-extension",
      "@jupyterlab/shortcuts-extension",
      "@jupyterlab/theme-dark-extension",
      "@jupyterlab/theme-light-extension",
      "@jupyterlab/translation-extension",
      "@jupyterlab/ui-components-extension"
    ]
  },
  "overrides": {
    "yjs": "13.5.49"
  }
}

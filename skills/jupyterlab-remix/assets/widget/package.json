{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "description": "One page with one notebook, made of JupyterLab components without the plugin system",
  "scripts": {
    "build": "rspack --mode=development",
    "build:prod": "rspack --mode=production",
    "clean": "rm -rf build"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@jupyter/web-components": "^0.17.1",
    "@jupyterlab/apputils": "~4.7.6",
    "@jupyterlab/codemirror": "~4.6.6",
    "@jupyterlab/completer": "~4.6.6",
    "@jupyterlab/coreutils": "~6.6.6",
    "@jupyterlab/docmanager": "~4.6.6",
    "@jupyterlab/docregistry": "~4.6.6",
    "@jupyterlab/markedparser-extension": "~4.6.6",
    "@jupyterlab/mathjax-extension": "~4.6.6",
    "@jupyterlab/notebook": "~4.6.6",
    "@jupyterlab/rendermime": "~4.6.6",
    "@jupyterlab/services": "~7.6.6",
    "@jupyterlab/theme-light-extension": "~4.6.6",
    "@jupyterlab/ui-components": "~4.6.6",
